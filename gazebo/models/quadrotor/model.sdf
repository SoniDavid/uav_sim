<?xml version="1.0"?>
<sdf version="1.9">
  <model name="quadrotor">
    <pose>0 0 0.05 0 0 0</pose>

    <!-- ─── Main body ─── -->
    <link name="base_link">
      <inertial>
        <mass>0.045</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>7.921e-5</ixx> <ixy>0</ixy> <ixz>0</ixz>
          <iyy>13.604e-5</iyy> <iyz>0</iyz>
          <izz>7.317e-5</izz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <geometry>
          <box><size>0.15 0.02 0.015</size></box>
        </geometry>
        <material><diffuse>0.2 0.2 0.8 1</diffuse></material>
      </visual>
      <visual name="body_visual2">
        <pose>0 0 0 0 0 1.5708</pose>
        <geometry>
          <box><size>0.15 0.02 0.015</size></box>
        </geometry>
        <material><diffuse>0.2 0.2 0.8 1</diffuse></material>
      </visual>
      <collision name="body_collision">
        <geometry>
          <box><size>0.15 0.15 0.03</size></box>
        </geometry>
      </collision>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/imu/data</topic>
        <imu>
          <angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x></angular_velocity>
          <linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x></linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- ─── Rotor links (X-configuration) ─── -->
    <!-- Motor 1: front-left  CW   (-x, +y) -->
    <link name="rotor_1">
      <pose>-0.0530 0.0530 0.008 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.66e-8</iyy><iyz>0</iyz><izz>9.75e-7</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.9 0.1 0.1 0.7</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Motor 2: front-right CCW  (+x, +y) -->
    <link name="rotor_2">
      <pose>0.0530 0.0530 0.008 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.66e-8</iyy><iyz>0</iyz><izz>9.75e-7</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.1 0.9 0.1 0.7</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Motor 3: rear-right  CW   (+x, -y) -->
    <link name="rotor_3">
      <pose>0.0530 -0.0530 0.008 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.66e-8</iyy><iyz>0</iyz><izz>9.75e-7</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.9 0.1 0.1 0.7</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Motor 4: rear-left   CCW  (-x, -y) -->
    <link name="rotor_4">
      <pose>-0.0530 -0.0530 0.008 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.66e-8</iyy><iyz>0</iyz><izz>9.75e-7</izz></inertia>
      </inertial>
      <visual name="vis">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
        <material><diffuse>0.1 0.9 0.1 0.7</diffuse></material>
      </visual>
      <collision name="col">
        <geometry><cylinder><radius>0.028</radius><length>0.003</length></cylinder></geometry>
      </collision>
    </link>
    <joint name="rotor_4_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_4</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ─── Multicopter motor model plugins ─── -->
    <!-- Motor 1 CW -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.07</timeConstantUp>
      <timeConstantDown>0.07</timeConstantDown>
      <maxRotVelocity>2640</maxRotVelocity>
      <motorConstant>2.64e-8</motorConstant>
      <momentConstant>5.4e-9</momentConstant>
      <commandSubTopic>/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <motorSpeedPubTopic>/motor_speed/motor_0</motorSpeedPubTopic>
    </plugin>

    <!-- Motor 2 CCW -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.07</timeConstantUp>
      <timeConstantDown>0.07</timeConstantDown>
      <maxRotVelocity>2640</maxRotVelocity>
      <motorConstant>2.64e-8</motorConstant>
      <momentConstant>5.4e-9</momentConstant>
      <commandSubTopic>/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <motorSpeedPubTopic>/motor_speed/motor_1</motorSpeedPubTopic>
    </plugin>

    <!-- Motor 3 CW -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.07</timeConstantUp>
      <timeConstantDown>0.07</timeConstantDown>
      <maxRotVelocity>2640</maxRotVelocity>
      <motorConstant>2.64e-8</motorConstant>
      <momentConstant>5.4e-9</momentConstant>
      <commandSubTopic>/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <motorSpeedPubTopic>/motor_speed/motor_2</motorSpeedPubTopic>
    </plugin>

    <!-- Motor 4 CCW -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_4_joint</jointName>
      <linkName>rotor_4</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.07</timeConstantUp>
      <timeConstantDown>0.07</timeConstantDown>
      <maxRotVelocity>2640</maxRotVelocity>
      <motorConstant>2.64e-8</motorConstant>
      <momentConstant>5.4e-9</momentConstant>
      <commandSubTopic>/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <motorSpeedPubTopic>/motor_speed/motor_3</motorSpeedPubTopic>
    </plugin>

    <!-- Odometry publisher -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odomTopic>/odom</odomTopic>
      <odomFrame>world</odomFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <updateFrequency>50</updateFrequency>
      <gaussianNoise>0.001</gaussianNoise>
    </plugin>

  </model>
</sdf>
